#define BOUNCE_AMOUNT 1

void main() {

    // initialize color
    vec3 pixel_color = vec3(0.0);

    // getinitial ray
    vec2 norm_coordinates = (gl_GlobalInvocationID.xy + vec2(0.5) + rand_vec3().xy) / (gl_NumWorkGroups.xy * gl_WorkGroupSize.xy);
    norm_coordinates.y = 1.0 - norm_coordinates.y;
    Ray ray = get_ray(limits.camera, norm_coordinates);


    // Initialize Hit Record
    HitRecord hit_record;
    bool not_absorbed = true;

    // bounces
    for(int bounce=0; bounce<BOUNCE_AMOUNT; bounce++){


        rayQueryEXT query;
        rayQueryInitializeEXT(
            query,
            topLevelAS,
            gl_RayFlagsNoneEXT, // TODO: figure out which are best
            0xFF,
            ray.origin,
            0.001,
            ray.direction,
            1e24
        );

        while(rayQueryProceedEXT(query)){
            if(rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT){
                // hit a bounding box, check if hit a sphere

                mat4x3 sphere_matrix = rayQueryGetIntersectionObjectToWorldEXT(query, false);

                Sphere tmp_sphere;
                tmp_sphere.center = sphere_matrix[3];
                tmp_sphere.radius = sphere_matrix[0][0];
                HitRecord tmp_record;

                bool hit = check_hit(ray, 0.001, 1e24, tmp_sphere, tmp_record);
                if(hit){
                    rayQueryGenerateIntersectionEXT(query, tmp_record.t);
                }
            }
        }

        if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT){
            // ray missed
            pixel_color = vec3(1.0, 0.0, 0.0);
        } else {
            // ray hit
            pixel_color = vec3(0.0, 1.0, 0.0);
        }


