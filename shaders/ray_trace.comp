// -----------------------------------------------------------------------------------
// hit system
bool check_hit(Ray ray, float t_min, float t_max, Sphere sphere, out HitRecord hit) {
    // quadratic setup
    vec3 oc = ray.origin - sphere.center;
    float a = length(ray.direction);
    a *= a;
    float half_b = dot(oc, ray.direction);
    float c = length(oc)*length(oc) - sphere.radius*sphere.radius;

    // check if there are real solutions
    float discriminant = half_b*half_b - a*c;
    if( discriminant < 0.0 ){
        return false; // miss
    }
    float sqrtd = sqrt(discriminant);

    // find the nearest root in the acceptable range
    float root = (-half_b - sqrtd) /a;
    if(root < t_min || root > t_max ){
        root = (-half_b + sqrtd) /a;
        if(root < t_min || root > t_max){
            return false; // miss
        }
    }

    // hill out hit record
    hit.p = ray_at(ray, root);
    hit.t = root;
    hit.mat_index = sphere.material_index;
    hit.mat_type = sphere.material_type;
    vec3 outward_normal = (hit.p - sphere.center) / sphere.radius;
    hit.front_face = dot(ray.direction, outward_normal) < 0.0;
    hit.normal = outward_normal * (2*float(hit.front_face)-1);
    return true; // hit
}


bool get_closest_hit(Ray ray, float t_min, float t_max, out HitRecord hit_record){
    bool hit_anything = false;
    float closest_so_far = t_max;

    for(uint i=0; i<limits.sphere_amount; i++){
        if(check_hit(ray, t_min, closest_so_far, spheres[i], hit_record)){
            hit_anything = true;
            closest_so_far = hit_record.t;
        }
    }

    return hit_anything;
}
