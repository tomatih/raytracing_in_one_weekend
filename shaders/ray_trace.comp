// -----------------------------------------------------------------------------------
// helpers
vec3 ray_at(Ray ray, float t){
    return ray.origin + t*ray.direction;
}

bool near_zero(vec3 vec){
    const float epsilon = 1e-8;
    return (abs(vec.x) < epsilon) && (abs(vec.y) < epsilon) && (abs(vec.z) < epsilon);
}

uvec4 counter = limits.initial_seed;

vec3 rand_vec3(){
    return uintToFloat(philox4x32_7(counter, ivec2(gl_GlobalInvocationID.xy))).xyz * 2.0 - 1.0;
}

vec3 random_in_unit_sphere(){
    vec3 rand = uintToFloat(philox4x32_7(counter, ivec2(gl_GlobalInvocationID.xy))).xyz;
    float theta = rand.y * 2 * PI;
    float phi = rand.z * PI;
    return vec3(
        rand.x * sin(theta) * cos(phi),
        rand.x * sin(theta) * sin(phi),
        rand.x * cos(theta)
    );
}

vec3 random_unit_vector(){
    return normalize(random_in_unit_sphere());
}

float reflectance(float cosine, float ref_idx){
    float r0 = (1.0-ref_idx) / (1.0+ref_idx);
    r0 *= r0;
    return r0 + (1.0-r0)*pow(1.0- cosine, 5.0);
}

vec3 my_refract(vec3 uv, vec3 n, float etai_over_etat){
    float cos_theta = min(dot(n,-uv),1.0);
    vec3 r_out_perpendicular = etai_over_etat * (uv + cos_theta*n);
    vec3 r_out_parallel = -sqrt(abs(1.0 - length(r_out_perpendicular) *  length(r_out_perpendicular))) * n;
    return r_out_parallel + r_out_perpendicular;
}

Ray get_ray(Camera camera, vec2 uv){

    const float fov = 0.349066;
    const vec3 up = vec3(0.0, 1.0, 0.0);
    const float aperture = 0.1;
    const float focus_distance = 10.0;

    // reconstruct front
    vec3 w = vec3(
        sin(camera.look_angles.x)*cos(camera.look_angles.y),
        sin(camera.look_angles.x)*sin(camera.look_angles.y),
        cos(camera.look_angles.x)
    ).xzy;

    float h = tan(fov / 2.0);
    float viewport_height = 2.0 * h;
    float viewport_width = camera.aspect_ratio * viewport_height;

    // unit vectors
    vec3 u = normalize(cross(up,w));
    vec3 v = cross(w,u);

    vec3 horizontal = focus_distance * viewport_width * u;
    vec3 vertical = focus_distance * viewport_height * v;

    vec3 lower_left_corner = camera.look_from - horizontal / 2.0 - vertical / 2.0 - focus_distance * w;

    // ray generation
    vec3 rd = aperture / 2.0 * random_in_unit_sphere();
    vec3 offset = u * rd.x + v * rd.y;

    Ray ray;

    ray.origin = camera.look_from + offset;
    ray.direction = lower_left_corner +uv.x*horizontal + uv.y*vertical - camera.look_from - offset;

    return ray;
}

