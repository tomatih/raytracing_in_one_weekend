#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D img;
layout(set = 0, binding = 1) buffer Ray {
    vec3 pos;
    vec3 origin;
} rays;

void main(){
    // get normalised normalised coordinates
    vec2 norm_coordinates = (gl_GlobalInvocationID.xy + vec2(0.5)) / vec2(imageSize(img));
    // Store pixel to output image
    imageStore(img, ivec2(gl_GlobalInvocationID.xy), vec4(norm_coordinates, 0.0, 1.0));
}