#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D img;

// TODO: optimize aligment
layout(push_constant) uniform PushConstantData {
    vec3 origin;
    vec3 lower_left_corner;
    vec3 horizontal;
    vec3 vertical;
    vec3 u;
    vec3 v;
    vec3 w;
    float lens_radius;
} camera;


#define SAMPLE_COUNT 1

void main(){

    // calculate ray;
    vec3 rd = camera.lens_radius * vec3(0.0);//random_in_unit_sphere(); //TODO: add random numbers
    vec3 offset = camera.u * rd.x + camera.v * rd.y;
    vec3 ray_origin = camera.origin + offset;
    vec3 ray_direction = camera.lower_left_corner + gl_GlobalInvocationID.x*camera.horizontal + gl_GlobalInvocationID.y*camera.vertical - camera.origin - offset;

    vec3 pixel_color = vec3(0.0);

    // sky gradient
    float t = 0.5*(normalize(ray_direction).y +1.0);
    pixel_color = mix(vec3(1.0),vec3(0.5, 0.7, 1.0), t);

    // Store pixel to output image
    vec3 color = pixel_color / SAMPLE_COUNT;
    color = sqrt(color);
    color = clamp(color, 0.0, 0.999);

    imageStore(img, ivec2(gl_GlobalInvocationID.xy), vec4(color, 1.0));
}